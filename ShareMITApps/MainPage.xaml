<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ShareMITApps"
             xmlns:models="clr-namespace:ShareMITApps.Models"
             xmlns:vm="clr-namespace:ShareMITApps.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:ShareMITApps.Converters"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:MainVewModel"
             x:Class="ShareMITApps.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource MITBackgroundColor}, Dark={StaticResource MITBackgroundColorDark}}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:BoolToRotationConverter x:Key="BoolToRotationConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section with Gradient -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderGradient}"
                StrokeShape="RoundRectangle 0,0,24,24"
                Padding="20,40,20,20"
                Margin="0,0,0,10">
            <Grid>
                <!-- Theme Toggle Button -->
                <Button Text="{Binding ThemeIcon}"
                        Style="{StaticResource ThemeToggleButton}"
                        Command="{Binding ToggleThemeCommand}"
                        HorizontalOptions="End"
                        VerticalOptions="Start" />

                <!-- Header Content -->
                <VerticalStackLayout Spacing="8" 
                                     VerticalOptions="Center">
                    <Label Text="🚀" 
                           FontSize="32" 
                           HorizontalOptions="Center" />
                    <Label Text="Mafyou IT" 
                           Style="{StaticResource HeaderStyle}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenWebsiteCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="IT pour Innovation &amp; Transformation" 
                           FontSize="14" 
                           TextColor="{AppThemeBinding Light=White, Dark=White}" 
                           Opacity="0.8" 
                           HorizontalOptions="Center" 
                           Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Content Section -->
        <ScrollView Grid.Row="1">
            <CollectionView ItemsSource="{Binding GroupedApps}" 
                            IsGrouped="True"
                            BackgroundColor="Transparent"
                            Margin="0,0,0,20">
                
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="4" />
                </CollectionView.ItemsLayout>

                    <!-- Category Header Template -->
                    <CollectionView.GroupHeaderTemplate>
                        <DataTemplate x:DataType="models:MITAppGroup">
                            <Border BackgroundColor="Transparent" Padding="0">
                                <Grid>
                                    <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource MITPrimaryColor}, Dark={StaticResource MITPrimaryColorDark}}" 
                                             Opacity="0.1" 
                                             CornerRadius="8" 
                                             Margin="20,15,20,5" />
                                    <Label Text="{Binding CategoryName}" 
                                           Style="{StaticResource CategoryHeaderStyle}">
                                        <Label.Shadow>
                                            <Shadow Brush="{AppThemeBinding Light={StaticResource MITShadowColor}, Dark={StaticResource MITShadowColorDark}}"
                                                    Offset="0,1"
                                                    Radius="2"
                                                    Opacity="0.3" />
                                        </Label.Shadow>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.GroupHeaderTemplate>

                    <!-- App Item Template -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MITApp">
                            <Border Style="{StaticResource CardStyle}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" 
                                                 Binding="{Binding IsExpanded}" 
                                                 Value="True">
                                        <Setter Property="Background" Value="{StaticResource CardGradient}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <VerticalStackLayout>
                                    <!-- App Header (Clickable) -->
                                    <Border BackgroundColor="Transparent" 
                                            Padding="20,20,20,15">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleExpanderCommand}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="Auto,*,Auto" 
                                              ColumnSpacing="16">
                                            
                                            <!-- App Icon -->
                                            <Border Grid.Column="0" 
                                                    BackgroundColor="{AppThemeBinding Light=#EDF2EB, Dark=#2A2A2A}" 
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="8"
                                                    WidthRequest="72"
                                                    HeightRequest="72">
                                                <Image Source="{Binding ImageUrl}"
                                                       Aspect="AspectFit" />
                                            </Border>
                                            
                                            <!-- App Info -->
                                            <VerticalStackLayout Grid.Column="1" 
                                                                 VerticalOptions="Center" 
                                                                 Spacing="4">
                                                <Label Text="{Binding Name}" 
                                                       Style="{StaticResource AppNameStyle}" 
                                                       HorizontalOptions="Start" />
                                                <Label Text="Touchez pour voir le QR Code" 
                                                       FontSize="12" 
                                                       TextColor="{AppThemeBinding Light={StaticResource MITTextSecondaryColor}, Dark={StaticResource MITTextSecondaryColorDark}}" 
                                                       Opacity="{Binding IsExpanded, Converter={StaticResource InvertedBoolConverter}}" />
                                                <Label Text="QR Code affiché - Touchez le code pour ouvrir l'app" 
                                                       FontSize="12" 
                                                       TextColor="{AppThemeBinding Light={StaticResource MITAccentColor}, Dark={StaticResource MITAccentColorDark}}" 
                                                       IsVisible="{Binding IsExpanded}" />
                                            </VerticalStackLayout>
                                            
                                            <!-- Expand Icon -->
                                            <Label Grid.Column="2" 
                                                   Text="▼" 
                                                   FontSize="16" 
                                                   TextColor="{AppThemeBinding Light={StaticResource MITPrimaryColor}, Dark={StaticResource MITPrimaryColorDark}}" 
                                                   VerticalOptions="Center" 
                                                   Rotation="{Binding IsExpanded, Converter={StaticResource BoolToRotationConverter}}" />
                                        </Grid>
                                    </Border>

                                    <!-- QR Code Expander -->
                                    <toolkit:Expander IsExpanded="{Binding IsExpanded}" 
                                                      Direction="Down">
                                        <toolkit:Expander.Header>
                                            <BoxView HeightRequest="0" 
                                                     BackgroundColor="Transparent" />
                                        </toolkit:Expander.Header>

                                        <!-- QR Code Container -->
                                        <Border BackgroundColor="{AppThemeBinding Light=#F5F6F7, Dark=#1F1F1F}" 
                                                StrokeShape="RoundRectangle 16" 
                                                Padding="24" 
                                                Margin="20,20,20,20">
                                            <VerticalStackLayout Spacing="16">
                                                <!-- QR Code Title -->
                                                <Label Text="Scanner ce code QR pour télécharger l'application" 
                                                       FontSize="14" 
                                                       TextColor="{AppThemeBinding Light={StaticResource MITTextSecondaryColor}, Dark={StaticResource MITTextSecondaryColorDark}}" 
                                                       HorizontalOptions="Center" 
                                                       HorizontalTextAlignment="Center" />

                                                <!-- QR Code Image -->
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource MITSurfaceColor}, Dark={StaticResource MITSurfaceColorDark}}" 
                                                        StrokeShape="RoundRectangle 12" 
                                                        Padding="16"
                                                        HorizontalOptions="Center">
                                                <Border.Shadow>
                                                    <Shadow Brush="{AppThemeBinding Light={StaticResource MITShadowColor}, Dark={StaticResource MITShadowColorDark}}"
                                                                Offset="0,2"
                                                                Radius="8"
                                                                Opacity="0.15" />
                                                </Border.Shadow>

                                                <ImageButton Source="{Binding MyQRImageSource}"
                                                                 Command="{Binding OpenAppLinkCommand}"
                                                                 CommandParameter="{Binding AppLink}"
                                                                 Aspect="AspectFit"
                                                                 Padding="16"
                                                                 WidthRequest="280"
                                                                 HeightRequest="280" />
                                            </Border>
                                        </VerticalStackLayout>
                                        </Border>
                                    </toolkit:Expander>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>
    </Grid>
</ContentPage>