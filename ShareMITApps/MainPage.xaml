<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ShareMITApps"
             xmlns:models="clr-namespace:ShareMITApps.Models"
             xmlns:vm="clr-namespace:ShareMITApps.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:MainVewModel"
             x:Class="ShareMITApps.MainPage">
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">
            <Label HorizontalOptions="Center"  Text="Mafyou Innovation Transformation" FontSize="20" />
            <CollectionView ItemsSource="{Binding Apps}">
                <!-- Single-column layout -->
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MITApp">
                        <!-- Main container -->
                        <Border
                            Stroke="LightGray"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="Black"
                            Padding="0"
                            Margin="0,0,0,10">

                            <!-- Logo + Name (clickable to expand) -->
                            <VerticalStackLayout>
                                <Border
                                Stroke="Black"
                                Padding="10"
                                BackgroundColor="Transparent">
                                    <VerticalStackLayout Spacing="5" BackgroundColor="Black">
                                        <Image
                                            Source="{Binding ImageUrl}"
                                            WidthRequest="80"
                                            HeightRequest="80"
                                            Aspect="AspectFill"
                                            HorizontalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpanderCommand}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <Label
                                            Text="{Binding Name}"
                                            FontAttributes="Bold"
                                            FontSize="16"
                                            HorizontalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpanderCommand}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Expander for QR Code -->
                                <toolkit:Expander x:Name="MyExpander"
                                              IsExpanded="{Binding IsExpanded}"
                                              Direction="Down">
                                    <toolkit:Expander.Header>
                                        <!-- Empty header (we use the logo/name as the trigger) -->
                                        <Label Text="" HeightRequest="0" />
                                    </toolkit:Expander.Header>

                                    <!-- Full-width QR Code -->
                                    <Border
                                        Stroke="LightGray"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="White"
                                        Padding="20"
                                        Margin="10,0,10,10">
                                    <Image
                                        Source="{Binding MyQRImageSource}"
                                        Aspect="AspectFit"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        MinimumHeightRequest="300" />
                                    </Border>
                                </toolkit:Expander>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>


</ContentPage>