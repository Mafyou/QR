@page "/"
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>

<div class="container">
    <h1 class="main-title">QR Code Scanner & Generator</h1>
    <div class="sections">
        <section class="scanner-section">
            <h2>Scanner un QR Code</h2>
            <p>Appuyez sur "Démarrer le scan" puis placez un QR code devant votre caméra.</p>
            <div id="reader" class="qr-reader"></div>
            <div class="scan-result">
                <label>Résultat :</label>
                <span class="result-text">@qrResult</span>
            </div>
            <button class="btn" @onclick="StartScan">Démarrer le scan</button>
        </section>

        <section class="generator-section">
            <h2>Générer un QR Code</h2>
            <EditForm Model="@this" OnValidSubmit="GenerateQrCode">
                <InputText class="input" @bind-Value="qrInput" placeholder="Entrez le texte à encoder" />
                <button class="btn" type="submit">Générer le QR</button>
            </EditForm>
            <div id="qrcode" class="qr-code"></div>
        </section>
    </div>
</div>

@code {
    private string qrResult;
    private string qrInput;

    [JSInvokable]
    public void OnQrCodeScanned(string result)
    {
        qrResult = result;
        StateHasChanged();
    }

    private async Task StartScan()
    {
        var dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("qrScanner.start", "reader", dotNetRef);
    }

    private async Task GenerateQrCode()
    {
        await JS.InvokeVoidAsync("qrCodeGenerator.generate", "qrcode", qrInput ?? "");
    }
}